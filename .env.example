# ─────────────────────────────────────────────────────────────
# .env.example — copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# Generate with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-long-random-secret-key-here

# True locally for debug error pages, False on Heroku
DEBUG=True

# Local: uses SQLite file (zero setup needed)
# Heroku: set automatically when PostgreSQL addon is attached
DATABASE_URL=sqlite:///db.sqlite3
